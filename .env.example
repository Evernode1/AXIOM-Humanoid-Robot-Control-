# AXIOM Humanoid Subnet — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to GitHub

# ── Konnex Wallet (Miner) ────────────────────────────────────────────────────
# Your 12-word mnemonic from SubWallet or Talisman
KNX_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# ── Konnex Wallet (Validator) — use a DIFFERENT wallet ───────────────────────
KNX_VALIDATOR_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# ── Konnex RPC ───────────────────────────────────────────────────────────────
KNX_RPC=wss://testnet-rpc1.konnex.world:39944
KNX_SUBNET_ID=4
KNX_POLL_S=8

# ── Firebase (optional — defaults already in lib/chain.js for AXIOM project) ──
# Only override if using your own Firebase project
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
